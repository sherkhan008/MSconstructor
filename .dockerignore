node_modules
.next
out
build
coverage
playwright-report
test-results
.git
.gitignore
# Every env file, including .env.production: `COPY . .` would otherwise put
# real secrets into image layers, and `next build` would load them.
.env
.env.*
Dockerfile
docker-compose*.yml
.dockerignore
README.md
DEPLOYMENT.md
*.log
.vscode
.idea
.claude
*.tsbuildinfo
# Operational state that must never enter an image.
backups
*.dump
*.dump.partial
.deploy

# Private supplier pricing supplied out-of-band; never inside an image.
private-data
exports

# Private keys, certificates and keystores, at any depth.
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.ppk
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*

# Database dumps, backups and logs at any depth. Prisma migrations are the
# only SQL the build needs (COPY prisma) and are re-included last.
**/*.dump
**/*.dump.partial
**/*.sql.gz
**/*.backup
**/*.bak
**/*.log
logs
**/*.sql
!prisma/migrations/**/*.sql
