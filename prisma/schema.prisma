// MS Shelving — primary data model.
// Postgres is the target database; a DATABASE_URL that is not a postgres://
// connection string causes the app to run entirely on the in-memory seed
// catalog in src/lib/data (see src/lib/env.ts hasDatabase).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: the runtime connection Prisma Client uses for every query —
// point this at a pooled connection (e.g. PgBouncer, or your provider's
// pooler) in production. DIRECT_URL: an unpooled connection used only by
// `prisma migrate`/`prisma db pull`, which need a direct connection to run
// schema commands. If your provider doesn't offer a separate pooled
// endpoint, DIRECT_URL may be omitted or set to the same value.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/* ============================================================================
 * Auth / admin
 * ========================================================================== */

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CONTENT_MANAGER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          AdminRole @default(MANAGER)
  active        Boolean   @default(true)
  // Server-side revocation boundary for this admin's stateless session
  // cookies (src/lib/auth/revocation.ts). Every issued token carries the
  // value this column had at login; incrementing it invalidates all of that
  // admin's sessions on their next authenticated request, without storing a
  // row per session. Bump it on password change, on a suspected leak, and
  // whenever an account is deactivated.
  sessionVersion Int      @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
  priceChanges  PriceHistory[]
  assignedOrders Order[]  @relation("OrderManager")
  issuedOrderDocuments OrderDocument[] @relation("OrderDocumentIssuer")

  @@index([role])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  previousData Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

/* ============================================================================
 * Catalog: models, dimensions, components, rules, accessories
 * ========================================================================== */

model ProductModel {
  id               String   @id @default(cuid())
  slug             String   @unique
  nameRu           String
  nameKk           String
  shortDescriptionRu String
  shortDescriptionKk String
  descriptionRu    String
  descriptionKk    String
  image            String
  gallery          String[]
  maxLoadKg        Int
  loadCapacities   Int[]
  heights          Int[]
  widths           Int[]
  depths           Int[]
  shelfTypes       String[]
  minShelves       Int      @default(2)
  maxShelves       Int      @default(8)
  useCases         String[]
  markupPercent    Decimal  @db.Decimal(6, 2) @default(20)
  markupFixed      Decimal  @db.Decimal(12, 2) @default(0)
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  seoTitle         String
  seoDescription   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         Product[]
  rules            ConfigurationRule[]

  @@index([active, sortOrder])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  modelId       String
  model         ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  nameRu        String
  nameKk        String
  descriptionRu String
  descriptionKk String
  seoTitle      String
  seoDescription String
  height        Int
  width         Int
  depth         Int
  shelves       Int
  sections      Int      @default(1)
  loadCapacity  Int
  shelfType     String
  color         String
  useCases      String[]
  inStock       Boolean  @default(true)
  popularity    Int      @default(0)
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images        ProductImage[]

  @@index([modelId])
  @@index([published, featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model HeightOption {
  id              String   @id @default(cuid())
  value           Int      @unique
  label           String
  priceAdjustment Decimal  @db.Decimal(12, 2) @default(0)
  leadTimeDays    Int      @default(2)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
}

model WidthOption {
  id              String   @id @default(cuid())
  value           Int      @unique
  label           String
  priceAdjustment Decimal  @db.Decimal(12, 2) @default(0)
  leadTimeDays    Int      @default(2)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
}

model DepthOption {
  id              String   @id @default(cuid())
  value           Int      @unique
  label           String
  priceAdjustment Decimal  @db.Decimal(12, 2) @default(0)
  leadTimeDays    Int      @default(2)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
}

model LoadCapacityOption {
  id        String   @id @default(cuid())
  value     Int      @unique
  label     String
  models    String[]
  maxWidth  Int
  maxDepth  Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  noteRu    String?
  noteKk    String?
}

model Component {
  id             String   @id @default(cuid())
  sku            String   @unique
  type           String
  nameRu         String
  nameKk         String
  sellingPrice   Decimal  @db.Decimal(12, 2)
  purchasePrice  Decimal  @db.Decimal(12, 2)
  weightKg       Decimal  @db.Decimal(8, 2)
  height         Int?
  width          Int?
  depth          Int?
  loadCapacity   Int?
  shelfType      String?
  variant        String?
  models         String[]
  colors         String[]
  inStock        Boolean  @default(true)
  leadTimeDays   Int      @default(2)
  supplierRef    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, active])
}

model ConfigurationRule {
  id            String        @id @default(cuid())
  modelId       String?
  model         ProductModel? @relation(fields: [modelId], references: [id], onDelete: Cascade)
  componentType String
  name          String
  formula       String
  condition     String?
  priority      Int           @default(0)
  active        Boolean       @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([componentType, active])
}

model Accessory {
  id                   String   @id @default(cuid())
  sku                  String   @unique
  slug                 String   @unique
  nameRu               String
  nameKk               String
  descriptionRu        String
  descriptionKk        String
  image                String
  unitPrice            Decimal  @db.Decimal(12, 2)
  purchasePrice        Decimal  @db.Decimal(12, 2)
  weightKg             Decimal  @db.Decimal(8, 2)
  models               String[]
  maxQuantityPerSection Int?
  inStock              Boolean  @default(true)
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ColorOption {
  id           String  @id @default(cuid())
  nameRu       String
  nameKk       String
  hex          String
  pricePercent Decimal @db.Decimal(5, 2) @default(0)
  leadTimeDays Int     @default(0)
  available    Boolean @default(true)
  sortOrder    Int     @default(0)
}

model AssemblyService {
  id            String  @id @default(cuid())
  nameRu        String
  nameKk        String
  descriptionRu String
  descriptionKk String
  method        String
  value         Decimal @db.Decimal(12, 2) @default(0)
  sortOrder     Int     @default(0)
  active        Boolean @default(true)
}

model DeliveryMethod {
  id              String  @id @default(cuid())
  kind            String
  nameRu          String
  nameKk          String
  descriptionRu   String
  descriptionKk   String
  basePrice       Decimal? @db.Decimal(12, 2)
  requiresAddress Boolean @default(false)
  sortOrder       Int     @default(0)
  active          Boolean @default(true)
}

/* ============================================================================
 * Pricing, discounts, price history
 * ========================================================================== */

model PricingSettings {
  id                    String  @id @default("singleton")
  vatPercent            Decimal @db.Decimal(5, 2) @default(16)
  pricesIncludeVat      Boolean @default(false)
  minMarginPercent      Decimal @db.Decimal(5, 2) @default(8)
  defaultMarkupPercent  Decimal @db.Decimal(5, 2) @default(22)
  currency              String  @default("KZT")
  priceLevelDiscounts   Json
  quantityBreaks        Json
  updatedAt             DateTime @updatedAt
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  discountPercent  Decimal   @db.Decimal(5, 2) @default(0)
  discountFixed    Decimal   @db.Decimal(12, 2) @default(0)
  minTotal         Decimal   @db.Decimal(12, 2) @default(0)
  active           Boolean   @default(true)
  validUntil       DateTime?
  createdAt        DateTime  @default(now())
}

model CustomerPriceLevel {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  level      String
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
}

enum PriceEntityType {
  COMPONENT
  ACCESSORY
}

/// Which price of an entity changed. Named by business meaning, not by
/// database column, so the same two values describe a Component
/// (sellingPrice/purchasePrice) and an Accessory (unitPrice — the public
/// selling price — and purchasePrice).
enum PriceField {
  SELLING_PRICE
  PURCHASE_PRICE
}

/// Append-only audit trail of catalog price changes.
///
/// `entityId` is a *logical* identifier, deliberately NOT a foreign key.
/// The original design declared it as an FK to Component AND to Accessory at
/// the same time, which required one id to exist in two different tables —
/// so no row could ever be inserted (the live database has 0 rows), and an
/// ON DELETE CASCADE would have erased the price trail the moment a catalog
/// entity was removed. History must outlive the entity it describes, so
/// `entityType` + `entityId` identify it and `entitySku`/`entityName` keep a
/// readable snapshot even after the catalog row is deactivated or deleted.
///
/// One row = one field of one entity changing once. A single admin edit that
/// changes both the selling and the purchase price writes two rows.
model PriceHistory {
  id           String           @id @default(cuid())
  entityType   PriceEntityType
  entityId     String
  /// SKU as it was at the time of the change — survives a later rename/delete.
  entitySku    String?
  /// Russian name as it was at the time of the change.
  entityName   String?
  /// NULL only on rows written before this column existed; every row the
  /// admin price service writes always records which field changed.
  field        PriceField?
  oldValue     Decimal?         @db.Decimal(12, 2)
  newValue     Decimal          @db.Decimal(12, 2)
  adminId      String?
  admin        User?            @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Actor name snapshot, so the trail still names who changed the price
  /// after that admin account is deleted and adminId is set to NULL.
  adminName    String?
  reason       String?
  createdAt    DateTime         @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([adminId])
  @@index([createdAt])
}

/* ============================================================================
 * Configurations, cart, customers, orders
 * ========================================================================== */

model SavedConfiguration {
  id            String   @id @default(cuid())
  name          String?
  shareToken    String   @unique @default(cuid())
  data          Json
  priceSnapshot Json
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shareToken])
}

model Customer {
  id           String   @id @default(cuid())
  type         String
  fullName     String
  phone        String
  whatsapp     String?
  email        String?
  city         String?
  companyName  String?
  binIin       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  configurations SavedConfiguration[]
  priceLevel   CustomerPriceLevel?

  @@index([phone])
  @@unique([phone, type])
}

/// The order lifecycle. The allowed steps between these states are enforced in
/// src/lib/orders/status-transitions.ts — the database stores the state, not
/// the policy.
enum OrderStatus {
  NEW
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  /// Immutable commercial-party data captured when this order is placed.
  /// Null only for orders created before the document snapshot migration.
  buyerSnapshot   Json?
  status          OrderStatus @default(NEW)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  managerId       String?
  manager         User?       @relation("OrderManager", fields: [managerId], references: [id], onDelete: SetNull)
  deliveryMethodId String?
  deliveryAddress String?
  deliveryCity    String?
  deliveryFloor   String?
  deliveryHasLift Boolean?
  deliveryDate    DateTime?
  deliveryComment String?
  paymentPreference String
  netTotal        Decimal     @db.Decimal(14, 2)
  vatTotal        Decimal     @db.Decimal(14, 2)
  discountTotal   Decimal     @db.Decimal(14, 2) @default(0)
  grandTotal      Decimal     @db.Decimal(14, 2)
  comment         String?
  internalNotes   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payments        Payment[]
  quotes          Quote[]
  documents       OrderDocument[]

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  configuration   Json
  bomSnapshot     Json
  /// Versioned customer-facing names, public BOM and the order-time price
  /// breakdown (goods, assembly, delivery, discount, VAT basis) captured at
  /// order creation. Deliberately excludes cost, supplier and markup data.
  documentSnapshot Json?
  quantity        Int      @default(1)
  unitNetPrice    Decimal  @db.Decimal(14, 2)
  totalNetPrice   Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  @@index([orderId])
}

enum OrderDocumentKind {
  COMMERCIAL_PROPOSAL
  INVOICE
}

/// One formal issued commercial document per order/kind. The PDF itself is
/// rendered on demand from these immutable issuance and order snapshots.
/// Rows are only ever created (src/lib/documents/issuance.ts), never updated.
model OrderDocument {
  id             String            @id @default(cuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind           OrderDocumentKind
  documentNumber String            @unique
  issuedAt       DateTime
  /// Versioned seller details + brand name as they were at first issuance.
  sellerSnapshot Json
  /// The admin who issued it; kept as a name even if the account is removed.
  issuedById     String?
  issuedBy       User?             @relation("OrderDocumentIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedByName   String
  createdAt      DateTime          @default(now())

  @@unique([orderId, kind])
  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/* ============================================================================
 * Payments, quotes
 * ========================================================================== */

/// The lifecycle of ONE payment attempt. Deliberately minimal: an attempt is
/// either still open (PENDING) or settled in one of four ways. There is no
/// REFUNDED state — a refund is a separate commercial event that happens
/// outside this system (the same reasoning as OrderStatus, which cancels
/// rather than reopens).
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

/// One payment attempt against one order.
///
/// An order may accumulate SEVERAL attempts — a failed, cancelled or expired
/// attempt is kept forever, never rewritten — but at most one may be open at
/// a time per provider (see `pendingKey`). Every amount here is derived on the
/// server from the order's own immutable total; no browser-supplied figure is
/// ever written to this table.
model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Which payment provider this attempt belongs to (the registry key in
  /// src/lib/payments/registry.ts). Renamed from the old `type` column, whose
  /// name did not say what it held; no row's value was changed.
  provider      String
  /// Server-side idempotency guard: "<orderId>:<provider>" while the attempt
  /// is PENDING, NULL the moment it settles. PostgreSQL allows any number of
  /// NULLs in a unique index, so this permits unlimited settled attempts while
  /// making a second OPEN attempt for the same order+provider impossible —
  /// including under a concurrent double-submit, which loses at the database
  /// rather than at a read-then-write race in application code.
  pendingKey    String?  @unique
  status        PaymentStatus @default(PENDING)
  /// The amount the customer is expected to pay, copied from the order total
  /// at creation time. Never recalculated, never accepted from a client.
  amount        Decimal  @db.Decimal(14, 2)
  /// ISO-4217. KZT for every attempt; the column exists so a later currency
  /// is a data change rather than a schema change.
  currency      String   @default("KZT")
  /// The provider's own identifier for this attempt. NULL until a provider
  /// issues one (and permanently NULL for an attempt that never reached one).
  externalId    String?
  invoiceNumber String?
  /// Short, secret-free explanation of why a settled attempt is not PAID.
  /// Sanitised before it is written (src/lib/payments/types.ts) — provider
  /// credentials, tokens and raw payloads must never reach this column.
  failureReason String?
  /// When the payment was confirmed PAID by a trusted path. NULL otherwise.
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model Quote {
  id            String   @id @default(cuid())
  quoteNumber   String   @unique
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?
  items         QuoteItem[]
  netTotal      Decimal  @db.Decimal(14, 2)
  vatTotal      Decimal  @db.Decimal(14, 2)
  grandTotal    Decimal  @db.Decimal(14, 2)
  validUntil    DateTime
  pdfUrl        String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model QuoteItem {
  id            String  @id @default(cuid())
  quoteId       String
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  configuration Json
  quantity      Int     @default(1)
  unitNetPrice  Decimal @db.Decimal(14, 2)
  totalNetPrice Decimal @db.Decimal(14, 2)

  @@index([quoteId])
}

/* ============================================================================
 * Integrations, notifications, translations
 * ========================================================================== */

model IntegrationSetting {
  id        String   @id @default(cuid())
  provider  String   @unique
  config    Json
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model IntegrationEvent {
  id         String   @id @default(cuid())
  provider   String
  eventType  String
  payload    Json
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
}

model NotificationLog {
  id         String   @id @default(cuid())
  channel    String
  target     String
  subject    String?
  success    Boolean
  error      String?
  relatedId  String?
  createdAt  DateTime @default(now())

  @@index([channel, createdAt])
}

model SeoMetadata {
  id          String  @id @default(cuid())
  path        String  @unique
  titleRu     String
  titleKk     String?
  descriptionRu String
  descriptionKk String?
  ogImage     String?
}

/// One attempt to deliver one internal order event over one channel.
///
/// Purely an outbox/troubleshooting record: it has NO foreign key to Order on
/// purpose, so it can never block, cascade into or roll back an order or
/// payment. `payload` is the already-redacted event (order number, statuses,
/// total — no customer name, phone, email or address) so a retry can re-send it
/// without re-reading the order. `lastError` is a short code, never a provider
/// message, URL or token.
model NotificationDelivery {
  id          String   @id @default(cuid())
  event       String
  channel     String
  /// SENT | FAILED
  status      String
  orderNumber String
  payload     Json
  attempts    Int      @default(1)
  lastError   String?
  /// When the notifications worker retries this FAILED row. Null = no
  /// automatic retry (SENT, permanent error, or retry limit reached).
  nextAttemptAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, channel])
  @@index([orderNumber])
  @@index([status, nextAttemptAt])
}
