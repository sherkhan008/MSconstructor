# ==============================================================================
# MS Shelving — production environment template (docker-compose.yml stack)
# ==============================================================================
# On the server:
#   cp .env.production.example .env.production
#   chmod 600 .env.production        # owner-only; never commit it (gitignored)
# then replace every CHANGE_ME value. scripts/ops/*.sh read this file and pass
# it to Compose as `--env-file`; Compose builds each container's environment
# from it explicitly (docker-compose.yml), so e.g. PostgreSQL never sees
# AUTH_SECRET.
#
# Classification used below:
#   [required secret]      must be set; never share, log or commit
#   [required]             must be set; not secret
#   [optional]             leave commented out unless you have a real value
#   [optional secret]      as above, and treat as a secret
#
# RULES
# - An empty assignment (`VAR=`) is INVALID and the app refuses to start.
#   Comment a line out instead of leaving it empty.
# - Generate secrets with the commands shown. Use hex for passwords: they are
#   embedded in connection URLs, where characters like @ : / # break parsing.
# - Missing security-critical values stop the stack before it starts
#   (Compose `:?` checks) or stop the app at startup
#   (src/lib/startup/production-config.ts). There are no insecure defaults.
#
# Not configured here, by design:
# - NODE_ENV=production and TRUSTED_PROXY_CLIENT_IP_HEADER=x-real-ip are fixed
#   in docker-compose.yml (the latter is the contract with deploy/nginx/default.conf).
# - DATABASE_URL / DIRECT_URL / REDIS_URL are assembled in docker-compose.yml
#   from the passwords below and the private service names.
# ==============================================================================

# --- Public origin ------------------------------------------------------------
# [required] The canonical public URL customers use: canonical links, sitemap,
# Open Graph. https:// in production.
APP_URL="https://CHANGE_ME.kz"

# --- Admin session signing key --------------------------------------------------
# [required secret] HMAC key for admin session cookies. At least 32 characters.
# Rotating it signs out every admin. Generate: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"

# --- PostgreSQL (the `postgres` service) --------------------------------------
# [required secret] Generate: openssl rand -hex 32
# Only read when the data volume is first initialised. Changing it later
# requires ALTER USER inside PostgreSQL as well — see docs/production-deployment.md.
POSTGRES_PASSWORD="CHANGE_ME"
# [optional] Defaults: ms_shelving / ms_shelving.
# POSTGRES_USER="ms_shelving"
# POSTGRES_DB="ms_shelving"

# --- Redis (the `redis` service, rate-limit counters only) ---------------------
# [required secret] Generate: openssl rand -hex 32
REDIS_PASSWORD="CHANGE_ME"

# --- Public proxy port ------------------------------------------------------------
# [optional] Host address:port nginx is published on. Default 80 (all
# interfaces). Behind a separate TLS terminator on the same host, bind to
# loopback instead, e.g. "127.0.0.1:8080".
# PUBLIC_HTTP_BIND="80"

# --- Build-time public values (inlined into the browser bundle) ---------------
# [required] The real company WhatsApp number: digits only, with country code
# (e.g. "77071234567"), no "+", spaces or punctuation. Passed to `docker build`
# as a build argument — changing it requires rebuilding the image.
NEXT_PUBLIC_WHATSAPP_NUMBER="CHANGE_ME"
# [optional] Analytics counters (public identifiers, not secrets).
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_YANDEX_METRICA_ID=

# --- Initial admin user (ONE-TIME seed only) --------------------------------------
# NOT passed to the running app. Supply these only on the command line for the
# one-time seed (docs/production-deployment.md, "First deploy"), never store
# the password in this file:
#   ADMIN_EMAIL=...  ADMIN_INITIAL_PASSWORD=...  (12+ characters, then change it)

# --- Seller details for order documents ---------------------------------------
# [optional, required before issuing invoices] The company's legal and banking
# details printed on commercial proposals and invoices (/admin/orders/[id]).
# Server-only. An invoice is refused until every value except SELLER_PHONE,
# SELLER_EMAIL and SELLER_KNP is set and valid; the admin page lists what is
# missing. Banking details are confidential business data: never commit them.
# SELLER_LEGAL_NAME="ТОО «...»"
# SELLER_BIN=            # 12 digits
# SELLER_ADDRESS=
# SELLER_PHONE=
# SELLER_EMAIL=
# SELLER_BANK_NAME=
# SELLER_IBAN=           # KZ + 18 characters
# SELLER_BIC=            # 8 or 11 characters
# SELLER_KBE=            # 2 digits
# SELLER_KNP=            # 3 digits

# --- Online payment (DISABLED — do not enable yet) --------------------------------
# [optional] Online card/wallet payment is a prepared foundation, not a live
# feature. No provider adapter is registered in this build
# (src/lib/payments/registry.ts), so POST /api/payments answers 404 and
# checkout continues to use the three offline methods (bank transfer, invoice,
# cash) confirmed by a manager.
#
# Leave PAYMENTS_ENABLED unset or "false". Only the exact string "true" turns
# it on, and doing so while PAYMENTS_PROVIDER names an adapter this build does
# not have STOPS THE SERVER AT STARTUP — deliberately, so the shop can never
# advertise an online payment it cannot actually take.
#
# Enabling it later takes three things, in this order:
#   1. official merchant credentials from the provider (see
#      docs/production-deployment.md, "Online payment");
#   2. an adapter registered in src/lib/payments/registry.ts;
#   3. these variables, plus that adapter's OWN credential variables — whose
#      names are defined by the adapter and are [required secret]. No provider
#      credential is named here, because none has been issued.
# PAYMENTS_ENABLED=false
# PAYMENTS_PROVIDER=       # registry key of the adapter, e.g. the future "kaspi"

# --- Order notifications ---------------------------------------------------------
# [optional] Telegram order events (order.created / order.status_changed / order.paid), redacted: no customer data.
#            Both values required; unset = skipped with a warn log, orders unaffected. TELEGRAM_BOT_TOKEN is a secret.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# [optional] Email (no transport wired yet: reported as unavailable, never as sent; see src/lib/notifications/channels.ts). SMTP_PASSWORD is a secret.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="orders@CHANGE_ME.kz"
# MANAGER_EMAIL="sales@CHANGE_ME.kz"
# [optional] WhatsApp Business API (wa.me links work without it). WHATSAPP_API_TOKEN is a secret.
# WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# [optional secret] CRM webhooks (the URLs embed credentials).
# AMOCRM_WEBHOOK_URL=
# BITRIX24_WEBHOOK_URL=

# --- Operations scripts (scripts/ops) -----------------------------------------------
# [optional] Host directory for PostgreSQL backups. Outside the repository and
# outside Docker volumes. Default: /var/backups/ms-shelving
# BACKUP_DIR="/var/backups/ms-shelving"
# [optional] Delete backups older than this many days. Default: 14.
# BACKUP_RETENTION_DAYS=14
# [optional] Never prune below this many newest backups, whatever their age. Default: 7.
# BACKUP_MIN_KEEP=7

# --- Development-only variables: DO NOT set in production -------------------------
# E2E_BASE_URL, PORT (fixed at 3000 in the image), NEXT_PUBLIC_APP_URL (would
# be baked into the image; APP_URL is used instead), STORAGE_* (not used yet).
