# ==============================================================================
# MS Shelving — production environment template
# ==============================================================================
# Unlike .env.example, these values are REQUIRED for a real deployment.
# See docs/production-database.md for the full PostgreSQL deployment checklist.
# ==============================================================================

NODE_ENV=production

# --- Database — REQUIRED. Managed Postgres (Neon, Supabase, RDS) or ----------
# --- self-hosted. See docs/production-database.md. DATABASE_URL is the ------
# --- pooled runtime connection; DIRECT_URL is the unpooled connection used --
# --- only by `prisma migrate` — set it to the same value if your provider ---
# --- doesn't offer a separate pooled endpoint. -------------------------------
DATABASE_URL="postgresql://user:password@host:5432/ms_shelving?schema=public&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/ms_shelving?schema=public&sslmode=require"

# --- App / auth ---------------------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://your-domain.kz"
APP_URL="https://your-domain.kz"
NEXT_PUBLIC_APP_URL="https://your-domain.kz"

# --- Initial admin user (rotate the password immediately after first login) --
ADMIN_EMAIL="admin@your-domain.kz"
ADMIN_INITIAL_PASSWORD="set-a-strong-password-then-rotate-it"

# --- Email notifications ------------------------------------------------------
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_USER="orders@your-domain.kz"
SMTP_PASSWORD=
EMAIL_FROM="orders@your-domain.kz"
MANAGER_EMAIL="sales@your-domain.kz"

# --- Telegram order notifications ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp customer deep links (wa.me) — REQUIRED ----------------------------
# The real company WhatsApp number. Digits only, with country code
# (e.g. "77071234567") — no "+", spaces, parentheses or hyphens.
NEXT_PUBLIC_WHATSAPP_NUMBER="77071234567"

# --- WhatsApp Business API (later phase — not required for wa.me links above) --
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- CRM webhooks ---------------------------------------------------------------
AMOCRM_WEBHOOK_URL=
BITRIX24_WEBHOOK_URL=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=

# --- Object storage for product photography / documents ----------------------
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- Redis: shared rate limiting / cache / sessions across instances ---------
# Rate limit counters are shared across instances only when this is set.
# If Redis becomes unreachable: public limits fall back to per-instance
# memory (same numbers), admin login is refused (503) until Redis recovers.
REDIS_URL="redis://user:password@host:6379"

# --- Trusted client IP — REQUIRED ---------------------------------------------
# Header your trusted reverse proxy OVERWRITES with the connecting client's IP
# (deploy/nginx/default.conf sets X-Real-IP). Set this ONLY if the app port is
# unreachable except through that proxy. Unset in production = no forwarding
# header is trusted and all clients share one rate-limit bucket per endpoint.
# See docs/production-client-ip-and-rate-limiting.md.
TRUSTED_PROXY_CLIENT_IP_HEADER="x-real-ip"

# --- Seller details for order documents — REQUIRED before issuing invoices ----
# The real company's legal and banking details, printed on the commercial
# proposal and invoice PDFs generated in /admin/orders/[id]. Server-only.
# An invoice cannot be generated until every value below except SELLER_PHONE,
# SELLER_EMAIL and SELLER_KNP is set and valid; the admin page lists what is
# missing. Never commit real values to the repository.
# Uncomment only with a real value: an empty assignment fails env validation.
# SELLER_LEGAL_NAME=
# SELLER_BIN=
# SELLER_ADDRESS=
# SELLER_PHONE=
# SELLER_EMAIL=
# SELLER_BANK_NAME=
# SELLER_IBAN=
# SELLER_BIC=
# SELLER_KBE=
# SELLER_KNP=
