# Files executed or parsed on the Linux production host must keep LF line
# endings even when the repository is checked out on Windows.
*.sh          text eol=lf
deploy/**     text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf

# RFC 4180 CRLF records: scripts/public-strings.ts and the localization tests
# parse this file byte for byte, so every checkout gets the same CRLF bytes.
docs/localization/public-strings.csv  text eol=crlf
