# ==============================================================================
# MS Shelving — local development environment
# ==============================================================================
# Copy to .env.local and fill in only what you actually have. Every value
# below is OPTIONAL for local development — leaving DATABASE_URL unset makes
# the app run entirely on the in-memory sample catalog in src/lib/data.
# ==============================================================================

# --- Database (optional in dev — omit to use the in-memory sample catalog) --
# Local PostgreSQL + Redis: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://ms_shelving:ms_shelving@localhost:5432/ms_shelving?schema=public"
DIRECT_URL="postgresql://ms_shelving:ms_shelving@localhost:5432/ms_shelving?schema=public"

# --- App / auth --------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-string"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Initial admin user (used by prisma/seed.ts) ------------------------------
ADMIN_EMAIL="admin@ms-stellazh.kz"
ADMIN_INITIAL_PASSWORD="ChangeMe123!"

# --- Email notifications (optional) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="orders@ms-stellazh.kz"
MANAGER_EMAIL="sales@ms-stellazh.kz"

# --- Telegram order notifications (optional) ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Order events (order.created, order.status_changed, order.paid) go to Telegram when both values are set.
# Payloads are redacted (order number, status, total only). Email has no SMTP transport yet, so it is
# reported as unavailable rather than pretending to send.

# --- WhatsApp customer deep links (wa.me) -------------------------------------
# Digits only, with country code, e.g. "77071234567" — no "+", spaces,
# parentheses or hyphens. Leaving this unset in dev falls back to a clearly
# non-functional placeholder (see src/lib/config/site.ts); it must be set for
# production or the WhatsApp buttons will not reach a real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- WhatsApp Business API (optional — wa.me deep links above work without this) --
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- CRM webhooks (optional) --------------------------------------------------
AMOCRM_WEBHOOK_URL=
BITRIX24_WEBHOOK_URL=

# --- Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=

# --- Object storage for uploaded photos/documents (optional) -----------------
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- Redis: shared rate limiting / cache / sessions (optional) ---------------
REDIS_URL=

# --- Online payment (DISABLED — leave it that way) ----------------------------
# Online card/wallet payment is a prepared foundation, not a working feature:
# no provider adapter is registered yet (src/lib/payments/registry.ts), so
# POST /api/payments answers 404 and checkout keeps using the three offline
# methods. Only the exact string "true" enables it; anything else is off.
# PAYMENTS_PROVIDER names an adapter that exists in this build — a provider's
# own credentials go in that adapter's variables, never here and never in
# source. Turning this on without a registered adapter stops a production
# server from starting, on purpose.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=

# --- Trusted client IP (leave unset locally) ----------------------------------
# Unset in development/test: the leftmost X-Forwarded-For is used so local
# tools and E2E tests can simulate clients. This fallback is never used in
# production runtime. See docs/production-client-ip-and-rate-limiting.md.
TRUSTED_PROXY_CLIENT_IP_HEADER=
# --- Seller details for admin order documents (optional in dev) ----------------
# Printed on the commercial proposal and the invoice generated from
# /admin/orders/[id] (see src/lib/documents/seller.ts). Server-only — never
# NEXT_PUBLIC_. Nothing has a default: a commercial proposal prints whatever is
# set (brand name only when nothing is), and an invoice is refused until the
# legal name, BIN, address, bank, IBAN, BIC and KBE are all set and valid.
# Uncomment only with a real value: an empty assignment fails env validation.
# SELLER_LEGAL_NAME="ТОО «...»"
# SELLER_BIN=            # 12 digits
# SELLER_ADDRESS=        # legal address
# SELLER_PHONE=
# SELLER_EMAIL=
# SELLER_BANK_NAME=
# SELLER_IBAN=           # ИИК: KZ + 18 characters
# SELLER_BIC=            # 8 or 11 characters
# SELLER_KBE=            # 2 digits
# SELLER_KNP=            # optional, 3 digits (код назначения платежа)
