# dependencies
node_modules/
.pnp
.pnp.js

# next
.next/
out/
build/
next-env.d.ts

# testing
coverage/
playwright-report/
test-results/
.playwright/

# env — every real env file (including .env.production on a server); only
# the committed templates are tracked.
.env
.env.*
!.env.example
!.env.production.example

# misc
.DS_Store
.vscode/
.idea/
*.tsbuildinfo

# private keys, certificates and keystores — never committed
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# database dumps and backups. Prisma migrations are the only SQL in the repo.
*.sql
!prisma/migrations/**/*.sql
*.sql.gz
*.backup
*.bak

# logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# prisma
prisma/dev.db
prisma/dev.db-journal

# claude code
.claude/settings.local.json

# operational state (scripts/ops) — backups and deploy history never belong in git
backups/
*.dump
*.dump.partial
.deploy/

# private supplier pricing — real purchase prices, supplied out-of-band.
# Never committed, never baked into an image (see .dockerignore).
private-data/
# ad-hoc local data exports (orders, leads, price lists)
exports/

.claude/*.local.md
.claude/settings.local.json
